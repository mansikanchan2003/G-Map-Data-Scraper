      "parameters": {
        "jsCode": "const input = $input.item.json;\n\nconst listingsRaw = input.stdout.match(/\\[.*\\]/s);\nif (!listingsRaw) {\n  throw new Error('No listings array found in stdout');\n}\n\nconst listings = JSON.parse(listingsRaw[0]);\nconst base = {\n  category: input.category,\n  officename: input.officename,\n  district: input.district,\n  statename: input.statename\n};\n\nreturn listings.map(entry => ({\n  json: {\n    ...base,\n    name: entry.title || '',\n    address: entry.address || '',\n    phone: entry.phone || '',\n    website: entry.website || ''\n  }\n}));\n"
