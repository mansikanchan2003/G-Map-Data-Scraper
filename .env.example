# =============================================================================
# G-Map Data Scraper 2.0 — Environment Configuration Template
# Copy this file to .env and fill in all values marked REQUIRED.
# NEVER commit your actual .env file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE (REQUIRED for production)
# ---------------------------------------------------------------------------
# SQLite (development / local testing — default):
DATABASE_URL=sqlite:///data/gmaps_discovery.db

# PostgreSQL (production — uncomment and fill in):
# DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

# ---------------------------------------------------------------------------
# PostgreSQL container credentials (used by docker-compose.yml)
# Only required when running with Docker Compose + PostgreSQL.
# ---------------------------------------------------------------------------
POSTGRES_DB=gmap_scraper
POSTGRES_USER=gmap_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ---------------------------------------------------------------------------
# Source data files
# Paths are relative to the project root (or absolute).
# ---------------------------------------------------------------------------
LOCATIONS_FILE=Geocoded_Ad_Targeting_Locations_FINAL.xlsx
CATEGORIES_FILE=G-Map Scraper Categories.xlsx

# ---------------------------------------------------------------------------
# Discovery settings
# ---------------------------------------------------------------------------
DEFAULT_RADIUS_KM=20.0
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
ELEMENT_TIMEOUT_MS=6000
DISCOVERY_CONCURRENCY=1
MAX_SCROLL_ATTEMPTS=4
SEARCH_DELAY_SECONDS=2.0
MAX_RESULTS_PER_JOB=200

# ---------------------------------------------------------------------------
# Job management
# ---------------------------------------------------------------------------
BATCH_SIZE=15
JOB_RETRY_LIMIT=3
STALE_JOB_AGE_MINUTES=30

# ---------------------------------------------------------------------------
# Email enrichment
# ---------------------------------------------------------------------------
EMAIL_ENRICHMENT_ENABLED=true
EMAIL_ENRICHMENT_TIMEOUT_SECONDS=30
EMAIL_ENRICHMENT_BATCH_TIMEOUT_SECONDS=120
EMAIL_MAX_PAGES_PER_SITE=4
EMAIL_NAVIGATION_TIMEOUT_MS=15000
EMAIL_MAX_CONCURRENCY=5

# ---------------------------------------------------------------------------
# API / Server
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# CORS_ORIGINS: comma-separated list of allowed frontend origins.
# Development defaults shown below. For production, set to your actual domain.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# n8n integration
# ---------------------------------------------------------------------------
# URL the backend is reachable at FROM n8n's perspective.
# In Docker Compose: http://backend:8000
# In bare-metal: http://your-server-ip:8000
BACKEND_BASE_URL=http://localhost:8000

# Google Sheets spreadsheet ID for n8n export (without the full URL).
# Example: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
N8N_OUTPUT_SPREADSHEET_ID=YOUR_GOOGLE_SHEET_ID_HERE

# ---------------------------------------------------------------------------
# Logging & environment
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Frontend (Vite)
# The React frontend reads this variable at build time.
# For development, leave blank — the proxy in vite.config.ts handles routing.
# For production builds, set to the full backend URL.
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=https://your-production-backend.example.com

# -----------------------------------------------------------------------------
# WhatsApp Meta Cloud API
# Obtain these from Meta Business Dashboard -> WhatsApp -> API Setup.
# Never commit real values.
# -----------------------------------------------------------------------------
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=gmap_scraper_verify_token
# Set to "true" to simulate sends without contacting Meta (local/testing only)
MOCK_WHATSAPP_API=false

# --- Google Sheets (the live "All Scraped Data from AutoGMap" sheet) --------
# Service account JSON, base64-encoded. The sheet is created by this account,
# which is why the address below has to be granted access explicitly.
GOOGLE_CREDENTIALS_BASE64=
# Who the sheet is shared with. Without it the sheet is created but belongs to
# the service account alone and nobody can open the link.
GOOGLE_SHEET_OWNER_EMAIL=

# --- Deployment behind a reverse proxy --------------------------------------
# The public sub-path, with trailing slash, e.g. /autogmap/ — baked into the
# frontend bundle at build time.
VITE_BASE_PATH=/
# Host ports. Discover these on the target server; never assume one is free.
# All three bind to 127.0.0.1 only.
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
N8N_HOST_PORT=5678

# --- Authentication ---------------------------------------------------------
# Signs session cookies. Falls back to POSTGRES_PASSWORD when unset, but set
# it explicitly in production so rotating the database password does not sign
# everyone out.
AUTH_JWT_SECRET=

# Approval emails. Optional: without these the admin still sees every request
# in the approvals queue, and nothing else changes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Wall-clock ceiling for one discovery job. A wedged browser does not always
# let Playwright's own timeouts fire; this is the backstop that abandons the
# job and lets the batch carry on.
JOB_TIMEOUT_SECONDS=600

# --- Template Studio (AI-drafted WhatsApp templates) -------------------------
# Gemini writes the copy, generates the photo and checks it. Without a key the
# Studio still shows existing drafts but cannot make new ones. Get one from
# Google AI Studio. The model overrides are optional: by default the best model
# this key can use is picked from a preference list.
GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=gemini-2.5-pro
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Campaign link destination ----------------------------------------------
# Where a tracked campaign link lands: the signup page, which opens on the
# form (the home page's #apply-now jump stops short of it). The kiosk site stores utm_source against
# the signup, so this is the source every lead from these links is recorded
# under. A source written into this URL wins over CAMPAIGN_UTM_SOURCE.
CAMPAIGN_LINK_TARGET_URL=https://kiosk.eko.in/signup?utm_source=AutoGMap
CAMPAIGN_LINK_FALLBACK_URL=https://kiosk.eko.in/signup?utm_source=AutoGMap
CAMPAIGN_UTM_SOURCE=AutoGMap
