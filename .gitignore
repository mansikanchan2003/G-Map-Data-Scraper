# =============================================================================
# G-Map Data Scraper 2.0 — .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.Python
.venv/
venv/
env/
.env
.env.*
*.env

# ---------------------------------------------------------------------------
# Secrets — NEVER commit these
# ---------------------------------------------------------------------------
service_account*.json
*credentials*.json
*-credentials.json
*.pem
*.key
*.p12
*.pfx
google_auth*.json

# ---------------------------------------------------------------------------
# Database files — local dev only
# ---------------------------------------------------------------------------
data/*.db
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Alembic — generated migration files from autogenerate are OK to commit,
# but the local SQLite test database is not.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Test artifacts
# ---------------------------------------------------------------------------
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.cover
.hypothesis/

# ---------------------------------------------------------------------------
# Frontend build artifacts
# ---------------------------------------------------------------------------
frontend/dist/
frontend/node_modules/

# ---------------------------------------------------------------------------
# Editor / IDE
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
docker-compose.override.yml

# ---------------------------------------------------------------------------
# Scraped data & local exports
# ---------------------------------------------------------------------------
cmd_output.txt
Scraped Data/gmap-scraper/
AI_Studio_UI/

# Exported business records. These are real contact details for real
# businesses and must never reach a public repository.
data/backups/
*.csv
!G-Map*.csv
.env.bak.*

# Business totals exported from Tara on the server (scripts/export_business_context.py)
data/business_context.json

# ---------------------------------------------------------------------------
# Deploys (scripts/deploy.sh): database backups and the deploy record
# ---------------------------------------------------------------------------
backups/
.deploy/

# The session key the app makes when AUTH_JWT_SECRET is not set (auth_service.SECRET_FILE)
data/.auth_jwt_secret

# ---------------------------------------------------------------------------
# Not for a public repository (checked 26 Nov 2026)
# ---------------------------------------------------------------------------
# What people sent and what we hold about them: chat media, uploaded documents,
# call recordings, bot videos, speech models, and any local export.
data/inbox_media/
data/onboarding_documents/
data/call_recordings/
data/bot_media/
data/whisper/
data/*.html
data/*.xlsx
data/*.json

# Spreadsheets and exports of real businesses, CSPs, branches and tasks. The two
# files the app reads (locations and categories) stay tracked.
*.xlsx
!Geocoded_Ad_Targeting_Locations_FINAL.xlsx
!G-Map Scraper Categories.xlsx
*.xls
*.tsv
~$*

# Old scraped data and experiments, not part of the app.
Scraped Data/
scratch/

# Local tool settings with personal paths.
.claude/launch.json
.claude/settings.local.json
